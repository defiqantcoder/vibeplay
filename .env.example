# vibeplay environment configuration
# Copy to .env and supply your API keys if desired.

# SQLite database file path (defaults to ~/.local/share/vibeplay/vibeplay.db)
VIBEPLAY_DB_PATH=~/.local/share/vibeplay/vibeplay.db

# Environment mode: development, testing, or production
VIBEPLAY_ENV=development

# AcoustID Web API key (free from https://acoustid.org/)
ACOUSTID_API_KEY=

# Google Gemini API key (for optional natural language playlist generation)
GEMINI_API_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
